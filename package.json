{
  "name": "lab-node-create-an-application",
  "version": "1.1.2",
  "description": "An auth0 training lab on implementing OpenID Connect based authentication in and express application.",
  "license": "MIT",
  "author": "Auth0",
  "bugs": {
    "url": "https://github.com/auth0-training/labs-node-create-an-application/issues"
  },
  "homepage": "https://github.com/auth0-training/labs-node-create-an-application.git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth0-training/labs-node-create-an-application.git"
  },
  "scripts": {
    "init": "npm ci --prefix ./src/web-app",
    "web-app:start": "npm start --prefix ./src/web-app",
    "web-app:dependencies": "npm ci --prefix ./src/web-app",
    "test": "node --test test/*.test.cjs"
  },
  "keywords": [
    "auth0",
    "oauth2",
    "openid",
    "oidc",
    "auth",
    "authentication",
    "samples",
    "labs"
  ],
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "quoteProps": "consistent",
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
