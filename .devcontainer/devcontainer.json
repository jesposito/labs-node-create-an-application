{
  "name": "Auth0 application lab",
  "dockerComposeFile": "docker-compose.yml",
  "service": "lab",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "vsls-contrib.codetour",
        "mikestead.dotenv",
        "auth0.vscode-labs",
        "humao.rest-client"
      ]
    }
  },
  "forwardPorts": [
    37500
  ],
  "portsAttributes": {
    "37500": {
      "label": "Expenses web app",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose",
  "postCreateCommand": "npm ci && npm run init",
  "waitFor": "postCreateCommand",
  "remoteUser": "node"
}
